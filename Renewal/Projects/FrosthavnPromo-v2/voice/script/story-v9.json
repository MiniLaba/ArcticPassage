    },
    {
      "id": "vo-09",
      "start": 84.1,
      "slotEnd": 90.4,
      "en": "Trade at the harbour. Make the day's work your own.",
      "zh": "回到港口交易，把劳作过成日常。",
      "position": "top",
      "duration": 3.759333333333333,
      "end": 87.8593,
      "file": "voice/segments-final/vo-09.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-10",
      "start": 91.4,
      "slotEnd": 94.58,
      "en": "Stay a little longer.",
      "zh": "不妨，再多住一阵。",
      "position": "bottom",
      "duration": 1.768,
      "end": 93.168,
      "file": "voice/segments-final/vo-10.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-11",
      "start": 94.7,
      "slotEnd": 100.375,
      "en": "Spring uncovers the rock beneath the snow.",
      "zh": "春天，岩岸从融雪间显露。",
      "position": "bottom",
      "duration": 3.5232916666666667,
      "end": 98.2233,
      "file": "voice/segments-final/vo-11.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-12",
      "start": 102.1,
      "slotEnd": 106.0,
      "en": "In summer, sunlight stays past midnight.",
      "zh": "夏天，阳光停留到午夜之后。",
      "position": "bottom",
      "duration": 3.565958333333333,
      "end": 105.666,
      "file": "voice/segments-final/vo-12.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-13",
      "start": 108.9,
      "slotEnd": 112.125,
      "en": "Autumn brings colour to the tundra.",
      "zh": "秋天，为苔原染上颜色。",
      "position": "bottom",
      "duration": 2.778,
      "end": 111.678,
      "file": "voice/segments-final/vo-13.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-14",
      "start": 114.8,
      "slotEnd": 119.875,
      "en": "Then winter settles into a long blue twilight.",
      "zh": "而冬天，沉入漫长的蓝色暮光。",
      "position": "bottom",
      "duration": 3.8633333333333333,
      "end": 118.6633,
      "file": "voice/segments-final/vo-14.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-15",
      "start": 120.9,
      "slotEnd": 127.2,
      "en": "Beyond the last houses, another trail is waiting.",
      "zh": "最后一排木屋之外，还有路等你出发。",
      "position": "top",
      "duration": 4.196,
      "end": 125.096,
      "file": "voice/segments-final/vo-15.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-16",
      "start": 133.7,
      "slotEnd": 141.8,
