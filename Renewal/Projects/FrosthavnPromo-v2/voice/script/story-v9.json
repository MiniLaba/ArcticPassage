    {
      "id": "vo-05",
      "start": 47.8,
      "slotEnd": 59.4,
      "en": "Meet the people who know these waters, and the lives built around them.",
      "zh": "认识熟悉这片海的人，走近他们的生活。",
      "position": "top",
      "duration": 5.463333333333333,
      "end": 53.2633,
      "file": "voice/segments-final/vo-05.wav",
      "fitsSlot": true
    },
    {
      "id": "vo-06",
      "start": 61.2,
      "slotEnd": 66.2,
      "en": "Find a quiet place where the ice opens.",
      "zh": "在冰层敞开的地方，停下脚步。",
